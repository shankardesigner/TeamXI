{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix front-end ci && npm --prefix front-end run build",
  "outputDirectory": "front-end/dist",
  "functions": {
    "api/index.py": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index/$1" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
